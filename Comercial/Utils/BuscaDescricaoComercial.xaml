<UserControl x:Class="Comercial.Utils.BuscaDescricaoComercial"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:Comercial.Utils" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>

        <!-- Grid de Itens -->
        <GroupBox Grid.Row="1"
                  Header="Itens"
                  Margin="0,0,0,10">
            <telerik:RadGridView 
                x:Name="rgViewItens"
                IsReadOnly="True"
                ItemsSource="{Binding PropostaDescricoes}"
                SelectedItem="{Binding PropostaDescricao}"
                AutoGenerateColumns="False"
                ShowGroupPanel="False"
                SearchPanelCloseButtonVisibility="Collapsed"
                ShowSearchPanel="True"
                Searching="rgViewItens_Searching"
                CanUserFreezeColumns="False"
                Margin="5" FontSize="8" FontFamily="Arial" 
                MouseDoubleClick="rgViewItens_MouseDoubleClick">
                
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="FAMÍLIA" DataMemberBinding="{Binding familia}"/>
                    <telerik:GridViewDataColumn Header="DESCRIÇÃO" Width="*" DataMemberBinding="{Binding descricaocomercial}"/>
                    <telerik:GridViewDataColumn Header="DIMENSÃO" Width="*" DataMemberBinding="{Binding dimensao}"/>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </GroupBox>

    </Grid>

</UserControl>
