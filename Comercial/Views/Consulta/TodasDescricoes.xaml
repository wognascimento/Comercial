<UserControl
    x:Class="Comercial.Views.Consulta.TodasDescricoes"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    d:DesignHeight="600"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,6"
            Orientation="Horizontal">
            <telerik:RadButton
                x:Name="sincronizarWooCommerceButton"
                MinWidth="190"
                Padding="12,4"
                Click="SincronizarWooCommerce_Click"
                Content="Buscar loja virtual" />
            <TextBlock
                x:Name="statusSincronizacaoText"
                Margin="10,0,0,0"
                VerticalAlignment="Center" />
        </StackPanel>

        <telerik:RadGridView
            x:Name="descricoesGrid"
            Grid.Row="1"
            RowHeight="100"
            GridLinesVisibility="Both"
            AutoGenerateColumns="False"
            CanUserDeleteRows="False"
            CanUserInsertRows="False"
            IsFilteringAllowed="True"
            ItemsSource="{Binding Descricoes}"
            PreviewMouseRightButtonDown="DescricoesGrid_PreviewMouseRightButtonDown"
            RowEditEnded="DescricoesGrid_RowEditEnded"
            ShowGroupPanel="False">
            <telerik:RadGridView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Adicionar Imagem" Click="AdicionarImagem_Click" />
                </ContextMenu>
            </telerik:RadGridView.ContextMenu>
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn
                    DataMemberBinding="{Binding coddimensao}"
                    Header="CÓD. DIMENSÃO"
                    IsReadOnly="True"
                    Width="110" />
                <telerik:GridViewDataColumn
                    DataMemberBinding="{Binding familia}"
                    Header="FAMÍLIA"
                    IsReadOnly="True"
                    Width="140" />
                <telerik:GridViewDataColumn
                    DataMemberBinding="{Binding descricaocomercial}"
                    TextWrapping="Wrap"
                    Header="DESCRIÇÃO COMERCIAL"
                    IsReadOnly="True"
                    Width="260" />
                <telerik:GridViewDataColumn
                    DataMemberBinding="{Binding dimensao}"
                    TextWrapping="Wrap"
                    Header="DIMENSÃO"
                    IsReadOnly="True"
                    Width="180" />
                <telerik:GridViewDataColumn
                    DataMemberBinding="{Binding descricao_licitacao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    Header="DESCRIÇÃO LICITAÇÃO"
                    Width="300" />
                <telerik:GridViewDataColumn
                    DataMemberBinding="{Binding preco, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    DataFormatString="{}{0:N2}"
                    Header="PREÇO"
                    TextAlignment="Right"
                    Width="110" />
                <telerik:GridViewCheckBoxColumn
                    DataMemberBinding="{Binding produto_woocommerce}"
                    Header="LOJA VIRTUAL"
                    IsReadOnly="True"
                    Width="105" />
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
